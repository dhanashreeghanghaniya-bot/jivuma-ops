NODE_ENV=development
PORT=4000

# The database is Supabase (Mumbai). Copy both strings from the Supabase dashboard:
# Connect -> ORMs / Connection string, and use the *pooler* hosts (the direct
# db.<ref>.supabase.co host is IPv6-only).
#   DATABASE_URL -> transaction pooler, port 6543, used by the running API.
#                   Keep ?pgbouncer=true: PgBouncer runs in transaction mode and
#                   cannot hold the prepared statements Prisma would otherwise use.
#   DIRECT_URL   -> session pooler, port 5432, used by `prisma migrate` and the seed.
# URL-encode any special characters in the password.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Use long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Set to true only when the API is served over HTTPS (production).
COOKIE_SECURE=false
COOKIE_DOMAIN=
# `lax` is correct while the web app and API share a registrable domain.
# If you deploy them to unrelated domains (e.g. *.vercel.app + *.railway.app),
# set COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# Phase 1 default password for every seeded user.
SEED_DEFAULT_PASSWORD=Juma@12345

# --- File storage (Phase 4+, not used yet) ---
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=juma-files
