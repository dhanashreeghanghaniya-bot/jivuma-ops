NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Browser key for the Maps JavaScript API, restricted by HTTP referrer and to
# Maps JavaScript API + Places API (New). See the README for the Cloud setup.
# Without these the dashboard falls back to a clickable district grid.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
